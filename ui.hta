<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Batch Steuerung</title>
<!-- HTA: laeuft mit mshta.exe und darf Batch-Dateien starten -->
<hta:application
    id="BatchUI"
    applicationname="BatchSteuerung"
    border="thin"
    borderstyle="normal"
    caption="yes"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    singleinstance="yes"
    sysmenu="yes"
    contextmenu="no"
    selection="no"
    innerborder="no"
/>
<style>
    html, body {
        margin: 0;
        height: 100%;
        background: #0c0c0c;
        color: #f2f2f2;
        font-family: "Segoe UI", Tahoma, sans-serif;
        overflow: hidden;
        user-select: none;
    }
    .wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding: 24px;
        box-sizing: border-box;
    }
    h1 {
        margin: 0 0 4px;
        font-size: 26px;
        letter-spacing: 4px;
        font-weight: 600;
    }
    .sub {
        margin: 0 0 32px;
        color: #767676;
        font-size: 13px;
        letter-spacing: 1px;
    }
    .buttons {
        display: flex;
        gap: 22px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .btn {
        width: 200px;
        padding: 22px 18px;
        border-radius: 12px;
        border: 1px solid #2a2a2a;
        background: #161616;
        color: #f2f2f2;
        text-align: center;
        cursor: pointer;
        transition: all .15s ease;
    }
    .btn:hover {
        border-color: #16c60c;
        background: #1c1c1c;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(22,198,12,.18);
    }
    .btn:active { transform: translateY(0); }
    .btn .icon { font-size: 34px; line-height: 1; }
    .btn .label {
        margin-top: 12px;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 1px;
    }
    .btn .desc {
        margin-top: 6px;
        font-size: 12px;
        color: #9a9a9a;
    }
    .btn.start:hover  { border-color: #16c60c; box-shadow: 0 6px 18px rgba(22,198,12,.22); }
    .btn.resume:hover { border-color: #e5b700; box-shadow: 0 6px 18px rgba(229,183,0,.22); }
    .footer {
        margin-top: 34px;
        font-size: 11px;
        color: #555;
        letter-spacing: 1px;
    }
</style>
<script type="text/javascript">
    // Verzeichnis dieser HTA ermitteln (damit die Batch-Dateien gefunden werden)
    function baseDir() {
        var full = decodeURIComponent(location.pathname).replace(/^\//, "").replace(/\//g, "\\");
        return full.substring(0, full.lastIndexOf("\\") + 1);
    }

    function run(file) {
        var fso   = new ActiveXObject("Scripting.FileSystemObject");
        var shell = new ActiveXObject("WScript.Shell");
        var path  = baseDir() + file;

        if (!fso.FileExists(path)) {
            alert("Datei nicht gefunden:\n" + path);
            return;
        }
        // In separatem Fenster oeffnen (cmd /k -> Fenster bleibt offen)
        shell.Run('cmd /k "' + path + '"', 1, false);
    }

    function startBatch()  { run("start.bat"); }
    function resumeBatch() { run("resume.bat"); }

    // Fenstergroesse setzen
    window.onload = function () {
        try { window.resizeTo(560, 420); } catch (e) {}
    };

    // Tastatur: 1 = Start, 2 = Fortsetzen, Esc = schliessen
    document.onkeydown = function () {
        var k = window.event.keyCode;
        if (k === 49) startBatch();        // 1
        else if (k === 50) resumeBatch();  // 2
        else if (k === 27) window.close(); // Esc
    };
</script>
</head>
<body>
    <div class="wrap">
        <h1>BATCH STEUERUNG</h1>
        <p class="sub">Waehle eine Option &nbsp;&middot;&nbsp; Tasten 1 / 2 &nbsp;&middot;&nbsp; Esc zum Schliessen</p>

        <div class="buttons">
            <div class="btn start" onclick="startBatch()">
                <div class="icon">&#9654;</div>
                <div class="label">Start</div>
                <div class="desc">startet den Vorgang neu</div>
            </div>

            <div class="btn resume" onclick="resumeBatch()">
                <div class="icon">&#10227;</div>
                <div class="label">Fortsetzen</div>
                <div class="desc">setzt den Vorgang fort</div>
            </div>
        </div>

        <div class="footer">Jede Option oeffnet ihre Batch-Datei in einem separaten Fenster</div>
    </div>
</body>
</html>
