<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>AUTO LV 2.0</title>
<!-- HTA: laeuft mit mshta.exe und darf Batch-Dateien starten -->
<hta:application
    id="BatchUI"
    applicationname="AutoLV"
    border="thin"
    borderstyle="normal"
    caption="yes"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    singleinstance="yes"
    sysmenu="yes"
    contextmenu="no"
    selection="no"
    innerborder="no"
/>
<style>
    html, body {
        margin: 0;
        height: 100%;
        background: #0c0c0c;
        color: #f2f2f2;
        font-family: "Segoe UI", Tahoma, sans-serif;
        overflow: hidden;
        user-select: none;
    }
    .wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        padding: 26px 26px 18px;
        box-sizing: border-box;
    }
    h1 {
        margin: 0 0 4px;
        font-size: 26px;
        letter-spacing: 6px;
        font-weight: 600;
    }
    .sub {
        margin: 0 0 26px;
        color: #767676;
        font-size: 12px;
        letter-spacing: 1px;
    }
    .buttons {
        display: flex;
        flex-direction: column;
        gap: 14px;
        width: 100%;
        max-width: 460px;
    }
    .btn {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 18px;
        border-radius: 12px;
        border: 1px solid #2a2a2a;
        background: #161616;
        color: #f2f2f2;
        cursor: pointer;
        transition: all .15s ease;
    }
    .btn:hover {
        background: #1c1c1c;
        transform: translateY(-2px);
    }
    .btn:active { transform: translateY(0); }
    .btn .icon { font-size: 26px; line-height: 1; width: 34px; text-align: center; }
    .btn .txt { text-align: left; }
    .btn .label { font-size: 17px; font-weight: 600; letter-spacing: .5px; }
    .btn .desc { margin-top: 3px; font-size: 12px; color: #9a9a9a; }
    .btn .key {
        margin-left: auto;
        font-size: 12px;
        color: #6a6a6a;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 2px 8px;
    }
    /* Akzentfarben pro Aktion */
    .btn.start  .icon { color: #16c60c; }
    .btn.skip   .icon { color: #3b9eff; }
    .btn.resume .icon { color: #e5b700; }
    .btn.start:hover  { border-color: #16c60c; box-shadow: 0 6px 18px rgba(22,198,12,.20); }
    .btn.skip:hover   { border-color: #3b9eff; box-shadow: 0 6px 18px rgba(59,158,255,.20); }
    .btn.resume:hover { border-color: #e5b700; box-shadow: 0 6px 18px rgba(229,183,0,.20); }
    .footer {
        margin-top: auto;
        padding-top: 16px;
        font-size: 11px;
        color: #555;
        letter-spacing: 1px;
    }
</style>
<script type="text/javascript">
    /* =========================================================
       CONFIG  -  hier die echten Batch-Dateinamen eintragen
       ========================================================= */
    var FILE_START  = "run.bat";       // Start
    var FILE_SKIP   = "skip.bat";      // Ueberspringen und Fortsetzen
    var FILE_RESUME = "continue.bat";  // Fortsetzen (ohne Ueberspringen)
    /* ========================================================= */

    // Verzeichnis dieser HTA ermitteln (damit die Batch-Dateien gefunden werden)
    function baseDir() {
        var full = decodeURIComponent(location.pathname).replace(/^\//, "").replace(/\//g, "\\");
        return full.substring(0, full.lastIndexOf("\\") + 1);
    }

    function run(file) {
        var fso   = new ActiveXObject("Scripting.FileSystemObject");
        var shell = new ActiveXObject("WScript.Shell");
        var path  = baseDir() + file;

        if (!fso.FileExists(path)) {
            alert("Datei nicht gefunden:\n" + path);
            return;
        }
        // In separatem Fenster oeffnen (cmd /k -> Fenster bleibt offen)
        shell.Run('cmd /k "' + path + '"', 1, false);
    }

    function doStart()  { run(FILE_START);  }
    function doSkip()   { run(FILE_SKIP);   }
    function doResume() { run(FILE_RESUME); }

    window.onload = function () {
        try { window.resizeTo(560, 470); } catch (e) {}
    };

    // Tastatur: 1 = Start, 2 = Ueberspringen+Fortsetzen, 3 = Fortsetzen, Esc = schliessen
    document.onkeydown = function () {
        var k = window.event.keyCode;
        if (k === 49) doStart();           // 1
        else if (k === 50) doSkip();       // 2
        else if (k === 51) doResume();     // 3
        else if (k === 27) window.close(); // Esc
    };
</script>
</head>
<body>
    <div class="wrap">
        <h1>AUTO LV 2.0</h1>
        <p class="sub">Waehle eine Option &nbsp;&middot;&nbsp; Tasten 1 / 2 / 3 &nbsp;&middot;&nbsp; Esc zum Schliessen</p>

        <div class="buttons">
            <div class="btn start" onclick="doStart()">
                <div class="icon">&#9654;</div>
                <div class="txt">
                    <div class="label">Start</div>
                    <div class="desc">startet den Vorgang neu</div>
                </div>
                <div class="key">1</div>
            </div>

            <div class="btn skip" onclick="doSkip()">
                <div class="icon">&#9197;</div>
                <div class="txt">
                    <div class="label">Ueberspringen und Fortsetzen</div>
                    <div class="desc">ueberspringe letzte Mappe und setze den Vorgang fort</div>
                </div>
                <div class="key">2</div>
            </div>

            <div class="btn resume" onclick="doResume()">
                <div class="icon">&#10227;</div>
                <div class="txt">
                    <div class="label">Fortsetzen</div>
                    <div class="desc">ohne zu ueberspringen</div>
                </div>
                <div class="key">3</div>
            </div>
        </div>

        <div class="footer">Jede Option oeffnet ihre Batch-Datei in einem separaten Fenster</div>
    </div>
</body>
</html>
